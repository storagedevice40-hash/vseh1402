{
  "crons": [
    {
      "path": "/api?action=processNightQueue",
      "schedule": "30 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}